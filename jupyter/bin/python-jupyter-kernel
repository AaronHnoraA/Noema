#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JUPYTER_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
EMACS_ROOT="$(cd "${JUPYTER_ROOT}/../../../.." && pwd)"
RUNTIME_ENV="${EMACS_ROOT}/var/aaronnote/runtime/python.env"

if [[ -r "$RUNTIME_ENV" ]]; then
  # Generated by scripts/aaronnote-runtime; values are shell-escaped.
  # shellcheck disable=SC1090
  source "$RUNTIME_ENV"
fi

PYTHON_BIN="${AARONNOTE_PYTHON:-}"
if [[ -z "$PYTHON_BIN" || ! -x "$PYTHON_BIN" ]]; then
  CONDA_BIN="${AARONNOTE_CONDA_EXE:-${CONDA_EXE:-}}"
  if [[ -z "$CONDA_BIN" ]]; then CONDA_BIN="$(command -v conda || true)"; fi
  [[ -n "$CONDA_BIN" ]] || { printf 'Noema Conda runtime metadata is missing; run make python-env.\n' >&2; exit 127; }
  exec "$CONDA_BIN" run --no-capture-output -n "${AARONNOTE_CONDA_ENV:-aaronnote-python}" python "$@"
fi

exec "$PYTHON_BIN" "$@"
