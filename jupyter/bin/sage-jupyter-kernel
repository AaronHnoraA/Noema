#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JUPYTER_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
JUPYTER_STATE_ROOT="${AARONNOTE_JUPYTER_STATE_ROOT:-${JUPYTER_ROOT}/.jupyter}"
RUNTIME_ENV="${AARONNOTE_SAGE_RUNTIME_ENV:-${AARONNOTE_RUNTIME_ENV:-}}"

if [[ -n "$RUNTIME_ENV" && -r "$RUNTIME_ENV" ]]; then
  # Optional host-provided metadata; Noema.app never discovers this through
  # an Emacs repository path.
  # shellcheck disable=SC1090
  source "$RUNTIME_ENV"
fi

LOG="${SAGE_JUPYTER_LOG:-${JUPYTER_STATE_ROOT}/logs/sagemath-kernel.log}"
SAGE_STATE_DIR="${DOT_SAGE:-${JUPYTER_STATE_ROOT}/sage}"
IPYTHON_STATE_DIR="${IPYTHONDIR:-${JUPYTER_STATE_ROOT}/ipython}"
JUPYTER_TMP_DIR="${TMPDIR:-${JUPYTER_STATE_ROOT}/tmp/}"
mkdir -p "$(dirname "$LOG")" \
  "$SAGE_STATE_DIR" \
  "$IPYTHON_STATE_DIR" \
  "$JUPYTER_TMP_DIR"

{
  printf '\n[%s] starting SageMath kernel\n' "$(date '+%F %T')"
  printf 'cwd=%s\n' "$(pwd)"
  printf 'argv='
  printf '%q ' "$@"
  printf '\n'
  env | sort | grep -E '^(HOME|USER|LOGNAME|SHELL|PATH|TMPDIR|DOT_SAGE|IPYTHONDIR|JUPYTER|SAGE|PYTHON|CONDA|VIRTUAL_ENV)=' || true
} >>"$LOG" 2>&1

export HOME="${HOME:-/Users/hc}"
export USER="${USER:-hc}"
export LOGNAME="${LOGNAME:-hc}"
export SHELL="${SHELL:-/bin/zsh}"
export DOT_SAGE="$SAGE_STATE_DIR"
export IPYTHONDIR="$IPYTHON_STATE_DIR"
export TMPDIR="$JUPYTER_TMP_DIR"
# Sage extensions are deliberately installed with `pip --user`.  Python
# treats any non-empty PYTHONNOUSERSITE value (including "0") as disabled.
unset PYTHONNOUSERSITE

SAGE_BIN="${AARONNOTE_SAGE:-}"
if [ -z "$SAGE_BIN" ] || [ ! -x "$SAGE_BIN" ]; then
  SAGE_BIN="$(command -v sage 2>/dev/null || true)"
  if [ -z "$SAGE_BIN" ]; then
    USER_ROOT="${HOME:-}"
    for candidate in \
      "${USER_ROOT:+${USER_ROOT}/sage/sage}" \
      /opt/homebrew/bin/sage \
      /usr/local/bin/sage \
      /Applications/SageMath.app/Contents/MacOS/sage; do
      if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        SAGE_BIN="$candidate"
        break
      fi
    done
  fi
  if [ -z "$SAGE_BIN" ] || [ ! -x "$SAGE_BIN" ]; then
    printf 'Sage executable not found; run make sage-refresh after installing SageMath.\n' >>"$LOG"
    exit 127
  fi
fi

export PATH="$(dirname "$SAGE_BIN"):/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

if [[ "${1:-}" == "--runtime-probe" ]]; then
  shift
  exec "$SAGE_BIN" --python "$@"
fi

exec "$SAGE_BIN" --python -m sage.repl.ipython_kernel "$@" 2>>"$LOG"
