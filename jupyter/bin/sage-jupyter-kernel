#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JUPYTER_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
EMACS_ROOT="$(cd "${JUPYTER_ROOT}/../../../.." && pwd)"
RUNTIME_ENV="${EMACS_ROOT}/var/aaronnote/runtime/sage.env"

if [[ -r "$RUNTIME_ENV" ]]; then
  # Generated by scripts/aaronnote-runtime; values are shell-escaped.
  # shellcheck disable=SC1090
  source "$RUNTIME_ENV"
fi

LOG="${SAGE_JUPYTER_LOG:-${JUPYTER_ROOT}/.jupyter/logs/sagemath-kernel.log}"
mkdir -p "$(dirname "$LOG")" \
  "${JUPYTER_ROOT}/.jupyter/sage" \
  "${JUPYTER_ROOT}/.jupyter/ipython" \
  "${JUPYTER_ROOT}/.jupyter/tmp"

{
  printf '\n[%s] starting SageMath kernel\n' "$(date '+%F %T')"
  printf 'cwd=%s\n' "$(pwd)"
  printf 'argv='
  printf '%q ' "$@"
  printf '\n'
  env | sort | grep -E '^(HOME|USER|LOGNAME|SHELL|PATH|TMPDIR|DOT_SAGE|IPYTHONDIR|JUPYTER|SAGE|PYTHON|CONDA|VIRTUAL_ENV)=' || true
} >>"$LOG" 2>&1

export HOME="${HOME:-/Users/hc}"
export USER="${USER:-hc}"
export LOGNAME="${LOGNAME:-hc}"
export SHELL="${SHELL:-/bin/zsh}"
export DOT_SAGE="${DOT_SAGE:-${JUPYTER_ROOT}/.jupyter/sage}"
export IPYTHONDIR="${IPYTHONDIR:-${JUPYTER_ROOT}/.jupyter/ipython}"
export TMPDIR="${TMPDIR:-${JUPYTER_ROOT}/.jupyter/tmp/}"
# Sage extensions are deliberately installed with `pip --user`.  Python
# treats any non-empty PYTHONNOUSERSITE value (including "0") as disabled.
unset PYTHONNOUSERSITE

SAGE_BIN="${AARONNOTE_SAGE:-}"
if [ -z "$SAGE_BIN" ] || [ ! -x "$SAGE_BIN" ]; then
  if command -v sage >/dev/null 2>&1; then
    SAGE_BIN="$(command -v sage)"
  else
    printf 'Sage executable not found; run make sage-refresh after installing SageMath.\n' >>"$LOG"
    exit 127
  fi
fi

export PATH="$(dirname "$SAGE_BIN"):/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

exec "$SAGE_BIN" --python -m sage.repl.ipython_kernel "$@" 2>>"$LOG"
