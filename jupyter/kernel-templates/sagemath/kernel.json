{
  "argv": [
    "@NOEMA_JUPYTER_ROOT@/bin/sage-jupyter-kernel",
    "-f",
    "{connection_file}"
  ],
  "display_name": "SageMath @SAGE_VERSION@",
  "language": "sage",
  "env": {
    "HOME": "@NOEMA_USER_HOME@",
    "NOEMA_JUPYTER_STATE_ROOT": "@NOEMA_JUPYTER_STATE_ROOT@",
    "JUPYTER_CONFIG_DIR": "@NOEMA_JUPYTER_STATE_ROOT@/config",
    "JUPYTER_DATA_DIR": "@NOEMA_JUPYTER_STATE_ROOT@/data",
    "JUPYTER_RUNTIME_DIR": "@NOEMA_JUPYTER_STATE_ROOT@/runtime",
    "PYTHONNOUSERSITE": "",
    "SAGE_JUPYTER_LOG": "@NOEMA_JUPYTER_STATE_ROOT@/logs/sagemath-kernel.log",
    "DOT_SAGE": "@NOEMA_JUPYTER_STATE_ROOT@/sage",
    "IPYTHONDIR": "@NOEMA_JUPYTER_STATE_ROOT@/ipython",
    "TMPDIR": "@NOEMA_JUPYTER_STATE_ROOT@/tmp/"
  },
  "metadata": {
    "debugger": false,
    "aaron": {
      "runtime": {
        "family": "python",
        "probe_argv": [
          "@NOEMA_JUPYTER_ROOT@/bin/sage-jupyter-kernel",
          "--runtime-probe"
        ]
      }
    }
  }
}
