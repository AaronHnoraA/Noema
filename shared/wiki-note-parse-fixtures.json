{
  "version": 1,
  "cases": [
    {
      "name": "meta block with id, aliases, tags",
      "file": "group.md",
      "content": "#+begin meta\nid: 019fb6e9-5a90-779a-9784-63e211090ac7\ntitle: Group Theory\naliases: Groups, 群论\ntags: algebra, structure\n#+end meta\n\n# Ignored heading\n\nSee [[Ring]] and [[Field|fields]].\n",
      "expected": {
        "title": "Group Theory",
        "persistedId": "019fb6e9-5a90-779a-9784-63e211090ac7",
        "identityStatus": "managed",
        "pageNamespaceAliases": [],
        "aliases": [
          "Groups",
          "群论"
        ],
        "tags": [
          "algebra",
          "structure"
        ],
        "blocks": [],
        "duplicateBlockIds": [],
        "wikiLinks": [
          {
            "target": "Ring",
            "label": "Ring"
          },
          {
            "target": "Field",
            "label": "fields"
          }
        ]
      }
    },
    {
      "name": "legacy timestamp id and heading title",
      "file": "legacy.md",
      "content": "#+begin meta\nid: 20261006T121300-graph-isomorphism\n#+end meta\n\n# Graph Isomorphism 图同构\n\nText.\n",
      "expected": {
        "title": "Graph Isomorphism 图同构",
        "persistedId": "20261006T121300-graph-isomorphism",
        "identityStatus": "legacy",
        "pageNamespaceAliases": [],
        "aliases": [],
        "tags": [],
        "blocks": [],
        "duplicateBlockIds": [],
        "wikiLinks": []
      }
    },
    {
      "name": "no metadata: provisional, title from heading",
      "file": "plain.md",
      "content": "# Plain Note\n\nA [[Target#Section]] link.\n",
      "expected": {
        "title": "Plain Note",
        "persistedId": "",
        "identityStatus": "provisional",
        "pageNamespaceAliases": [],
        "aliases": [],
        "tags": [],
        "blocks": [],
        "duplicateBlockIds": [],
        "wikiLinks": [
          {
            "target": "Target#Section",
            "label": "Target#Section"
          }
        ]
      }
    },
    {
      "name": "no heading: title from file name",
      "file": "file-name-title.md",
      "content": "Just text.\n",
      "expected": {
        "title": "file-name-title",
        "persistedId": "",
        "identityStatus": "provisional",
        "pageNamespaceAliases": [],
        "aliases": [],
        "tags": [],
        "blocks": [],
        "duplicateBlockIds": [],
        "wikiLinks": []
      }
    },
    {
      "name": "links: roam, fragments, markdown .md#, external ignored",
      "file": "links.md",
      "content": "# L\n\n[r](roam://019fb7a8-12ff-752d-ad5a-958fc37f4a1f) [f](#local) [m](./other.md#top) [w](https://example.org/README.md#x) [mail](mailto:a@b.c)\n",
      "expected": {
        "title": "L",
        "persistedId": "",
        "identityStatus": "provisional",
        "pageNamespaceAliases": [],
        "aliases": [],
        "tags": [],
        "blocks": [],
        "duplicateBlockIds": [],
        "wikiLinks": [
          {
            "target": "roam://019fb7a8-12ff-752d-ad5a-958fc37f4a1f",
            "label": ""
          },
          {
            "target": "#local",
            "label": ""
          },
          {
            "target": "./other.md#top",
            "label": ""
          }
        ]
      }
    },
    {
      "name": "code fences and inline code hide links",
      "file": "code.md",
      "content": "# C\n\n```md\n[[NotALink]]\n```\n\n`[[AlsoNot]]` but [[Real]].\n",
      "expected": {
        "title": "C",
        "persistedId": "",
        "identityStatus": "provisional",
        "pageNamespaceAliases": [],
        "aliases": [],
        "tags": [],
        "blocks": [],
        "duplicateBlockIds": [],
        "wikiLinks": [
          {
            "target": "Real",
            "label": "Real"
          }
        ]
      }
    },
    {
      "name": "block ids: anchor and org env",
      "file": "blocks.md",
      "content": "# B\n\nA paragraph. {#para-1}\n\n#+begin theorem Mathon {#thm-mathon}\nBody\n#+end theorem\n\nAgain {#para-1}\n",
      "expected": {
        "title": "B",
        "persistedId": "",
        "identityStatus": "provisional",
        "pageNamespaceAliases": [],
        "aliases": [],
        "tags": [],
        "blocks": [
          {
            "id": "thm-mathon",
            "kind": "org-env",
            "envKind": "theorem",
            "label": "theorem · Mathon",
            "offset": 54
          },
          {
            "id": "para-1",
            "kind": "anchor",
            "envKind": "",
            "label": "para-1",
            "offset": 92
          }
        ],
        "duplicateBlockIds": [
          "para-1"
        ],
        "wikiLinks": []
      }
    },
    {
      "name": "comment anchors keep only their text",
      "file": "comments.md",
      "content": "# K\n\nSome {==commented [[Linked]] text==}{>>#c-abc<<} here.\n",
      "expected": {
        "title": "K",
        "persistedId": "",
        "identityStatus": "provisional",
        "pageNamespaceAliases": [],
        "aliases": [],
        "tags": [],
        "blocks": [],
        "duplicateBlockIds": [],
        "wikiLinks": [
          {
            "target": "Linked",
            "label": "Linked"
          }
        ]
      }
    },
    {
      "name": "namespace aliases",
      "file": "ns.md",
      "content": "#+begin meta\nnamespace: math\nnamespace_aliases: maths, mathematics\n#+end meta\n\n# N\n",
      "expected": {
        "title": "N",
        "persistedId": "",
        "identityStatus": "provisional",
        "pageNamespaceAliases": [
          "maths",
          "mathematics"
        ],
        "aliases": [],
        "tags": [],
        "blocks": [],
        "duplicateBlockIds": [],
        "wikiLinks": []
      }
    }
  ]
}
