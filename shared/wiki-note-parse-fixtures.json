{
  "version": 1,
  "cases": [
    {
      "name": "meta block with id, aliases, tags",
      "file": "group.md",
      "content": "#+begin meta\nid: 019fb6e9-5a90-779a-9784-63e211090ac7\ntitle: Group Theory\naliases: Groups, 群论\ntags: algebra, structure\n#+end meta\n\n# Ignored heading\n\nSee [[Ring]] and [[Field|fields]].\n",
      "expected": {
        "title": "Group Theory",
        "persistedId": "019fb6e9-5a90-779a-9784-63e211090ac7",
        "identityStatus": "managed",
        "pageNamespaceAliases": [],
        "aliases": [
          "Groups",
          "群论"
        ],
        "tags": [
          "algebra",
          "structure"
        ],
        "blocks": [],
        "duplicateBlockIds": [],
        "wikiLinks": [
          {
            "target": "Ring",
            "label": "Ring"
          },
          {
            "target": "Field",
            "label": "fields"
          }
        ]
      }
    },
    {
      "name": "legacy timestamp id and heading title",
      "file": "legacy.md",
      "content": "#+begin meta\nid: 20261006T121300-graph-isomorphism\n#+end meta\n\n# Graph Isomorphism 图同构\n\nText.\n",
      "expected": {
        "title": "Graph Isomorphism 图同构",
        "persistedId": "20261006T121300-graph-isomorphism",
        "identityStatus": "legacy",
        "pageNamespaceAliases": [],
        "aliases": [],
        "tags": [],
        "blocks": [],
        "duplicateBlockIds": [],
        "wikiLinks": []
      }
    },
    {
