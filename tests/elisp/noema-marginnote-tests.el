;;; noema-marginnote-tests.el --- MarginNote sync entry tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'noema-marginnote)

(defun noema-marginnote-tests--resolution (&optional disabled)
  "Return a minimal effective pack resolution, optionally DISABLED."
  `((packs . [((id . "marginnote-digitize")
               (selectable . ,(if disabled :json-false t))
               (effective . ((preamble . "Keep manual edits.")))
               (members . [((id . "marginnote-digitize") (state . "available"))
                           ((id . "pdf") (state . "available"))]))])
    (skills . [((id . "marginnote-digitize") (selectable . t)
                (source . ((path . "skills/native/SKILL.md"))))
               ((id . "pdf") (selectable . t)
                (source . ((path . "skills/pdf/SKILL.md")))
                (patches . [((source . "noema-capabilities.json")
                             (patch . ((content_append . "Use note assets.")
                                       (patch_file . "patches/pdf.diff"))))]))])))

(ert-deftest noema-marginnote-effective-pack-keeps-source-and-scoped-patches ()
  (pcase-let ((`(,guidance . ,files)
               (noema-marginnote--pack-context
                (noema-marginnote-tests--resolution) "/tmp/noema/")))
    (should (string-match-p "Keep manual edits" guidance))
    (should (string-match-p "Use note assets" guidance))
    (should (equal files '("/tmp/noema/skills/native/SKILL.md"
                           "/tmp/noema/skills/pdf/SKILL.md"
                           "/tmp/noema/patches/pdf.diff")))))

(ert-deftest noema-marginnote-unavailable-pack-never-delivers ()
  (dolist (resolution (list nil (noema-marginnote-tests--resolution t)))
    (should-error (noema-marginnote--pack-context resolution "/tmp/")
                  :type 'user-error))
  (let ((resolution (noema-marginnote-tests--resolution)))
    (setcdr (assoc 'members (aref (cdr (assoc 'packs resolution)) 0))
            [((id . "gone") (state . "missing"))])
    (should-error (noema-marginnote--pack-context resolution "/tmp/")
                  :type 'user-error)))

(ert-deftest noema-marginnote-pack-dependencies-are-referenced-once ()
  (let* ((resolution (noema-marginnote-tests--resolution))
         (skills (cdr (assoc 'skills resolution))))
    (setf (alist-get 'effective (aref skills 0)) '((requires . ["pdf"])))
    (should (= 3 (length (cdr (noema-marginnote--pack-context resolution "/tmp/")))))))

;;; Sync

(ert-deftest noema-marginnote-sync-project-query-keeps-its-directory ()
  (let ((origin (generate-new-buffer " *MN origin*")) callback query started)
    (unwind-protect
        (cl-letf (((symbol-function 'noema-current-project)
                   (lambda (&rest _) "/tmp/project/"))
                  ((symbol-function 'noema-capability-list)
                   (lambda (&rest args)
                     (setq query args callback (plist-get args :callback))))
                  ((symbol-function 'noema-marginnote--sync-start)
                   (lambda (&rest _) (setq started default-directory))))
          (with-current-buffer origin
            (setq default-directory "/tmp/project/notes/")
            (noema-marginnote-sync "native-id"))
          (with-temp-buffer
            (funcall callback (noema-marginnote-tests--resolution) nil))
          (should (equal (plist-get query :project) "/tmp/project/"))
          (should-not (plist-get query :scope))
          (should (equal started "/tmp/project/notes/")))
      (kill-buffer origin))))

(ert-deftest noema-marginnote-sync-mounts-pack-and-request-in-own-session ()
  (let* ((noema-marginnote-work-root "/tmp/noema-mn-work/")
         query started started-effort)
    (with-temp-buffer
      (setq default-directory "/tmp/")
      (cl-letf (((symbol-function 'noema-current-project) (lambda (&rest _) nil))
                ((symbol-function 'noema-capability-list)
                 (lambda (&rest args)
                   (setq query args)
                   (funcall (plist-get args :callback)
                            (noema-marginnote-tests--resolution) nil)))
                ((symbol-function 'noema-marginnote--sync-start)
                 (lambda (text &optional effort) (setq started text started-effort effort)))
                ((symbol-function 'noema-context-send-prompt)
                 (lambda (&rest _) (error "Sync must not use the current agent"))))
        (noema-marginnote-sync "第三章转成 Wiki 页并挂 wikilink" "/tmp/n.md" "append" "xhigh")))
    (should (equal started-effort "xhigh"))
    (should (equal (plist-get query :requested-packs) '("marginnote-digitize")))
    (should (string-match-p "skills/native/SKILL.md" started))
    (should (string-match-p "Keep manual edits" started))
    (should (string-search "/tmp/noema-mn-work/" started))
    (should (string-search "Target: \"/tmp/n.md\"" started))
    (should (string-match-p "Write mode append: Append" started))
    (should (string-suffix-p "Request:\n第三章转成 Wiki 页并挂 wikilink" started))))

(ert-deftest noema-marginnote-sync-names-syntax-instead-of-inlining-it ()
  (let* ((directory (make-temp-file "mn-sync-syntax-" t))
         (user-emacs-directory (file-name-as-directory directory))
         (syntax (expand-file-name "docs/noema/design/syntax.md" directory))
         (resolution (copy-tree (noema-marginnote-tests--resolution) t))
         (pack (aref (cdr (assoc 'packs resolution)) 0)))
    (unwind-protect
        (progn
          (make-directory (file-name-directory syntax) t)
          (with-temp-file syntax (insert "SYNTAX BODY"))
          (setf (alist-get 'members pack)
                (vconcat (alist-get 'members pack)
                         [((id . "noema-authoring-syntax") (state . "available"))]))
          (setf (alist-get 'skills resolution)
                (vconcat (alist-get 'skills resolution)
                         [((id . "noema-authoring-syntax") (selectable . t)
                           (source . ((path . "skills/syntax/SKILL.md"))))]))
          (let ((guidance (car (noema-marginnote--pack-context resolution directory))))
            (should (string-search syntax guidance))
            (should-not (string-search "SYNTAX BODY" guidance))))
      (delete-directory directory t))))

(ert-deftest noema-marginnote-sync-without-target-leaves-it-to-the-prompt ()
  (let ((text (noema-marginnote--sync-task "转成新笔记" nil nil)))
    (should (string-match-p "Target: not given" text))
    (should-not (string-match-p "Write mode" text))))

(ert-deftest noema-marginnote-sync-rejects-bad-modes-before-querying ()
  (let ((file (make-temp-file "mn-sync-target-" nil ".md")))
    (unwind-protect
        (cl-letf (((symbol-function 'noema-capability-list)
                   (lambda (&rest _) (error "Queried"))))
          (should-error (noema-marginnote-sync "x" file "new") :type 'user-error)
          (should-error (noema-marginnote-sync "x" file "rewrite") :type 'user-error)
          (should-error (noema-marginnote-sync "  " file "update") :type 'user-error)
          (should-error (noema-marginnote-sync "x" file "update" "huge") :type 'user-error))
      (delete-file file))))

(ert-deftest noema-marginnote-sync-session-is-pinned-and-sends-once-ready ()
  (let* ((noema-marginnote-work-root (make-temp-file "mn-sync-root-" t))
         (agent (generate-new-buffer " *mn-sync-agent*"))
         started callback prompted shown)
    (unwind-protect
        (cl-letf (((symbol-function 'noema-agent-acp-config-for)
                   (lambda (_) '((:identifier . codex))))
                  ((symbol-function 'noema-agent-acp-start)
                   (lambda (&rest args) (setq started args) agent))
                  ((symbol-function 'noema-agent-acp-subscribe)
                   (lambda (&rest args) (setq callback (plist-get args :callback)) 'sub))
                  ((symbol-function 'noema-agent-acp-unsubscribe) #'ignore)
                  ((symbol-function 'noema-agent-acp-export-model-id)
                   (lambda (model &rest _) model))
                  ((symbol-function 'noema-agent-acp-current-model-id)
                   (lambda (&rest _) "gpt-6.1-terra"))
                  ((symbol-function 'noema-agent-acp-prompt)
                   (lambda (&rest args) (setq prompted args)))
                  ((symbol-function 'noema-agent-acp-show-buffer)
                   (lambda (buffer) (setq shown buffer))))
          (let ((noema-marginnote-sync-model "gpt-6.1-terra")
                (noema-marginnote-sync-effort "xhigh"))
            (noema-marginnote--sync-start "TASK"))
          (let ((config (plist-get started :config)))
            (should (equal (alist-get :noema-pinned-model config) "gpt-6.1-terra"))
            (should (equal (funcall (alist-get :default-config-options config))
                           '(("reasoning_effort" . "xhigh")))))
          (should (eq (plist-get started :origin) 'marginnote))
          (should (equal (file-name-as-directory (plist-get started :directory))
                         (file-name-as-directory
                          (expand-file-name noema-marginnote-work-root))))
          (should (eq shown agent))
          (should-not prompted)
          (funcall callback nil)
          (should (equal (plist-get prompted :content)
                         '(((type . "text") (text . "TASK"))))))
      (kill-buffer agent)
      (delete-directory noema-marginnote-work-root t))))

(ert-deftest noema-marginnote-sync-defaults-to-high-and-honours-a-chosen-effort ()
  (let* ((noema-marginnote-work-root (make-temp-file "mn-sync-root-" t))
         (agent (generate-new-buffer " *mn-sync-agent*"))
         configs)
    (unwind-protect
        (cl-letf (((symbol-function 'noema-agent-acp-config-for)
                   (lambda (_) '((:identifier . codex))))
                  ((symbol-function 'noema-agent-acp-start)
                   (lambda (&rest args) (push (plist-get args :config) configs) agent))
                  ((symbol-function 'noema-agent-acp-subscribe) #'ignore)
                  ((symbol-function 'noema-agent-acp-show-buffer) #'ignore))
          (noema-marginnote--sync-start "TASK")
          (noema-marginnote--sync-start "TASK" "xhigh")
          (should (equal (mapcar (lambda (config)
                                   (funcall (alist-get :default-config-options config)))
                                 (reverse configs))
                         '((("reasoning_effort" . "high"))
                           (("reasoning_effort" . "xhigh"))))))
      (kill-buffer agent)
      (delete-directory noema-marginnote-work-root t))))

(ert-deftest noema-marginnote-sync-never-runs-on-an-unselected-model ()
  (let* ((noema-marginnote-work-root (make-temp-file "mn-sync-root-" t))
         (agent (generate-new-buffer " *mn-sync-agent*"))
         callback prompted drafted)
    (unwind-protect
        (cl-letf (((symbol-function 'noema-agent-acp-config-for)
                   (lambda (_) '((:identifier . codex))))
                  ((symbol-function 'noema-agent-acp-start) (lambda (&rest _) agent))
                  ((symbol-function 'noema-agent-acp-subscribe)
                   (lambda (&rest args) (setq callback (plist-get args :callback)) 'sub))
                  ((symbol-function 'noema-agent-acp-unsubscribe) #'ignore)
                  ((symbol-function 'noema-agent-acp-export-model-id) (lambda (&rest _) nil))
                  ((symbol-function 'noema-agent-acp-current-model-id)
                   (lambda (&rest _) "gpt-6-astra"))
                  ((symbol-function 'noema-agent-acp-prompt)
                   (lambda (&rest args) (setq prompted args)))
                  ((symbol-function 'noema-agent-acp-draft)
                   (lambda (_buffer text) (setq drafted text)))
                  ((symbol-function 'noema-agent-acp-show-buffer) #'ignore))
          (let ((noema-marginnote-sync-model "gpt-6.1-terra"))
            (noema-marginnote--sync-start "TASK"))
          (funcall callback nil)
          (should-not prompted)
          (should (equal drafted "TASK")))
      (kill-buffer agent)
      (delete-directory noema-marginnote-work-root t))))

(provide 'noema-marginnote-tests)
