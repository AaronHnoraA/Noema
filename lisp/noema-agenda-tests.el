;;; noema-agenda-tests.el --- Native Agenda contract tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'noema-agenda)
(require 'noema-research)
(require 'noema-research-mode)

(defun noema-agenda-test--snapshot ()
  (copy-tree '((todos . [((uid . "one") (id . "#abc123") (scopeId . "knowledge")
               (file . "/vault/note.md") (source . "@@todo [Native]{id: abc123}")
               (sourceRef . ((revision . "rev1")))
               (text . "Native task") (status . "todo") (effectiveStatus . "todo")
               (noteTitle . "Research") (canon . ((prio . "A") (tags . "proof"))))
              ((uid . "two") (id . "#abc124") (scopeId . "knowledge")
               (text . "Finished task") (status . "done") (effectiveStatus . "done")
               (noteTitle . "Research") (canon . ((prio . "D"))))])
    (days . [((date . "2026-09-15")
              (entries . [((todoId . "one") (kind . "scheduled") (label . "Scheduled") (time . "10:00"))
                           ((todoId . "two") (kind . "deadline") (label . "Deadline"))]))])
    (errors . [])) t))

(defmacro noema-agenda-test--with-buffer (&rest body)
  `(with-temp-buffer
     (noema-agenda-mode)
     (setq noema-agenda--from "2026-09-15")
     (noema-agenda--render (noema-agenda-test--snapshot))
     ,@body))

(ert-deftest noema-agenda-native-render-never-converts-to-org ()
  (let ((org-agenda-files '("/unrelated/personal.org")))
    (cl-letf (((symbol-function 'make-temp-file) (lambda (&rest _) (ert-fail "temporary file")))
              ((symbol-function 'write-region) (lambda (&rest _) (ert-fail "write")))
              ((symbol-function 'org-mode) (lambda (&rest _) (ert-fail "Org source buffer")))
              ((symbol-function 'org-agenda-list) (lambda (&rest _) (ert-fail "Org scanner")))
              ((symbol-function 'org-agenda-get-day-entries) (lambda (&rest _) (ert-fail "Org source entries"))))
      (noema-agenda-test--with-buffer
       (should (string-match-p "10:00" (buffer-string)))
       (should (string-match-p "TODO.*Native task" (buffer-string)))
       (goto-char (point-min)) (search-forward "Native task")
       (should (equal "one" (noema-agenda--get (noema-agenda-item-at-point) 'uid)))
       (should-not (get-text-property (point) 'org-marker))
       (should (equal org-agenda-files '("/unrelated/personal.org")))))))

(ert-deftest noema-agenda-default-includes-unscheduled-roam-tasks ()
  "The default Org-style view must not hide parsed tasks without dates."
  (with-temp-buffer
    (noema-agenda-mode)
    (setq noema-agenda--from "2026-09-16")
    (noema-agenda--render
     '((todos . [((uid . "roam-open") (id . "#roam-open")
                  (scopeId . "knowledge") (file . "/vault/research.md")
                  (text . "Unscheduled Roam task") (status . "todo")
                  (effectiveStatus . "todo") (canon . ((prio . "B"))))])
       (days . [((date . "2026-09-16") (entries . []))])
       (errors . [])))
    (should (equal noema-agenda--blocks '((agenda) (todo))))
    (should (string-match-p "Tasks" (buffer-string)))
    (should (string-match-p "TODO.*Unscheduled Roam task" (buffer-string)))))

(ert-deftest noema-agenda-has-no-inherited-org-source-writers ()
  (noema-agenda-test--with-buffer
   (should (eq (key-binding (kbd "t")) #'noema-agenda-complete))
   (should (eq (key-binding (kbd "s")) #'noema-agenda-schedule))
   (should (eq (key-binding (kbd "r")) #'noema-agenda-refresh))
   (should (eq (key-binding (kbd "R")) #'noema-agenda-toggle-knowledge))
   (should (eq (key-binding (kbd ".")) #'noema-agenda-toggle-completed))
   (should (eq (key-binding (kbd "v .")) #'noema-agenda-today))
   (should (eq (key-binding (kbd "v r")) #'noema-agenda-repeat))
   (should-not (where-is-internal #'org-agenda-todo (current-local-map)))
   (should-not (where-is-internal #'org-agenda-clock-in (current-local-map)))
   (should-not (where-is-internal #'org-agenda-archive (current-local-map)))))

