(ert-deftest noema-agenda-write-refuses-dirty-source-and-preserves-late-edits ()
  (let ((source (generate-new-buffer " *agenda-source*")) callback reverted)
    (unwind-protect
        (noema-agenda-test--with-buffer
         (cl-letf (((symbol-function 'get-file-buffer) (lambda (_file) source))
                   ((symbol-function 'noema-agenda--call) (lambda (_operation _body done) (setq callback done)))
                   ((symbol-function 'revert-buffer) (lambda (&rest _) (setq reverted t))))
           (with-current-buffer source (insert "unsaved"))
           (goto-char (point-min)) (search-forward "Native task")
           (should-error (noema-agenda-complete) :type 'user-error)
           (should-not callback)
           (with-current-buffer source (set-buffer-modified-p nil))
           (noema-agenda-complete)
           (with-current-buffer source (insert "late edit"))
           (funcall callback '((ok . t)) nil)
           (should-not reverted)
           (should (with-current-buffer source (buffer-modified-p)))))
      (kill-buffer source))))

