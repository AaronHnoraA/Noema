   (let ((snapshot (copy-tree noema-agenda--snapshot)))
     (setf (alist-get 'days snapshot)
           [((date . "2026-09-15") (entries . [((todoId . "two") (kind . "log") (label . "Done"))
                                               ((todoId . "one") (kind . "scheduled") (label . "Scheduled"))]))])
     (setf (alist-get 'clocktable snapshot)
           '((tasks . [((todoId . "one") (text . "Native task") (minutes . 90))])
             (runningClocks . [((text . "Native task") (from . "2026-09-15 10:00") (minutesSoFar . 15))])))
     (setf (alist-get 'projectModel snapshot)
           [((title . "Paper") (done . 1) (total . 2) (progress . 50) (childTodoIds . ["one" "two"]))])
     (setq noema-agenda--snapshot snapshot)
     (cl-letf (((symbol-function 'noema-agenda--call) (lambda (&rest _) (ert-fail "local view made a request"))))
       (noema-agenda-log)
       (should (string-match-p "Finished task" (buffer-string)))
       (should-not (string-match-p "Native task" (buffer-string)))
       (noema-agenda-clocktable)
       (should (string-match-p "1:30" (buffer-string)))
       (should (string-match-p "Running: Native task" (buffer-string)))
       (noema-agenda-projects)
