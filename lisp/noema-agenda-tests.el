        (noema-agenda--project-scope "old-scope")
        (noema-agenda--project-lease "old-lease")
        (noema-agenda--project-request 0)
        (noema-agenda--reconnect nil)
        calls)
    (cl-letf (((symbol-function 'noema-agenda--call)
               (lambda (operation body _callback) (push (cons operation body) calls))))
      (noema-agenda-host-stopped)
      (should-not calls)
