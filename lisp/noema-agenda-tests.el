(ert-deftest noema-agenda-project-placement-and-stale-acquisition ()
  (let ((noema-agenda--project-root nil)
        (noema-agenda--project-scope nil)
        (noema-agenda--project-lease nil)
        (noema-agenda--project-request 0)
        (noema-agenda-project-root-function (lambda (_root) "/client/project/"))
        calls callbacks)
    (cl-letf (((symbol-function 'noema-agenda--update-scopes) #'ignore)
              ((symbol-function 'noema-agenda--call)
               (lambda (operation body callback)
                 (push (cons operation body) calls)
                 (when (equal operation "enter") (push callback callbacks)))))
      (noema-agenda-activate-project "/fs:shared:/project/")
      (should (equal (alist-get 'root (cdar calls)) "/client/project/"))
      (let ((lease (alist-get 'lease (cdar calls))))
        (noema-agenda-activate-project nil)
        (funcall (car callbacks) '((id . "late-scope")) nil)
        (should-not noema-agenda--project-scope)
        (should (equal (car calls) `("leave" (id . "late-scope") (lease . ,lease)))))
      (let ((before (length calls))
            (noema-agenda-project-root-function (lambda (_) (user-error "unsupported placement"))))
        (noema-agenda-activate-project "/fs:unavailable:/project/")
        (should-not noema-agenda--project-root)
        (should (= before (length calls)))))))

(ert-deftest noema-agenda-project-entry-callbacks-share-one-lease-and-cancel-on-exit ()
  (let ((noema-agenda--project-root nil) (noema-agenda--project-scope nil)
        (noema-agenda--project-lease nil) (noema-agenda--project-request 0)
        (noema-agenda--project-callbacks nil) (noema-agenda-project-root-function #'identity)
        calls callbacks results)
    (cl-letf (((symbol-function 'noema-agenda--update-scopes) #'ignore)
              ((symbol-function 'noema-agenda--call)
               (lambda (operation body callback)
                 (push (cons operation body) calls)
                 (when (equal operation "enter") (push callback callbacks)))))
      (noema-agenda-activate-project "/project")
      (noema-agenda-activate-project "/project" (lambda (result error) (push (list result error) results)))
      (should (= (length calls) 1)) (should-not results)
      (funcall (car callbacks) '((id . "scope")) nil)
      (should (equal results '((((id . "scope")) nil))))
      (noema-agenda-activate-project "/next" (lambda (result error) (push (list result error) results)))
      (noema-agenda-activate-project nil)
      (should (equal (alist-get 'message (cadar results)) "Project entry superseded"))
      (should-not noema-agenda--project-callbacks)
      (funcall (car callbacks) '((id . "late-scope")) nil)
      (should (= (length results) 2))
      (should (equal (caar calls) "leave")))))

