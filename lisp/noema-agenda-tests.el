       (should (string-match-p "Native task" (buffer-string)))))))

(ert-deftest noema-agenda-date-picker-returns-native-date-and-prefix-clears ()
  (noema-agenda-test--with-buffer
   (goto-char (point-min)) (search-forward "Native task")
   (let (request)
     (cl-letf (((symbol-function 'org-read-date) (lambda (&rest _) "2026-09-21 09:30"))
               ((symbol-function 'noema-agenda--call) (lambda (_operation body _callback) (setq request body))))
