(provide 'noema-agenda-tests)

(ert-deftest noema-agenda-navigation-ignores-superseded-and-unfocused-queries ()
  (let ((buffer (generate-new-buffer " *agenda navigation*")) callbacks visited)
    (unwind-protect
        (save-window-excursion
          (switch-to-buffer buffer)
          (cl-letf (((symbol-function 'noema-agenda-item-at-point)
                     (lambda () '((uid . "task") (scopeId . "knowledge"))))
                    ((symbol-function 'noema-agenda--call)
                     (lambda (_op _body callback) (push callback callbacks)))
                    ((symbol-function 'noema-agenda-visit-record)
                     (lambda (record) (push record visited))))
            (noema-agenda-visit)
            (noema-agenda-visit)
            (funcall (cadr callbacks) '((todos . [((uid . "task"))])) nil)
            (should-not visited)
            (funcall (car callbacks) '((todos . [((uid . "task"))])) nil)
            (should (= 1 (length visited)))
            (noema-agenda-visit)
            (switch-to-buffer (get-buffer-create "*scratch*"))
            (funcall (car callbacks) '((todos . [((uid . "task"))])) nil)
            (should (= 1 (length visited)))))
      (kill-buffer buffer))))


(ert-deftest noema-agenda-navigation-resolves-live-task-not-identical-code-text ()
  (let* ((source "@@todo [Same]{id: task}")
         (record `((source . ,source) (sourceRef . ((id . "#task") (revision . "old")))))
         (snapshot `((contentRevision . "new")
                     (todos . [((id . "#task") (index . 73) (source . ,source))]))))
    (should (= 73 (noema-agenda--get (noema-agenda--snapshot-task snapshot record) 'index)))
    (should-error (noema-agenda--snapshot-task '((todos . [])) record) :type 'user-error)))

(ert-deftest noema-agenda-navigation-only-disambiguates-positions-in-the-same-revision ()
  (let ((snapshot '((contentRevision . "v1")
                    (todos . [((index . 0) (source . "@@todo [Same]"))
                               ((index . 14) (source . "@@todo [Same]"))]))))
    (should (= 14 (noema-agenda--get
                   (noema-agenda--snapshot-task snapshot '((source . "@@todo [Same]")
                                                          (sourceRef . ((revision . "v1") (index . 14))))) 'index)))
    (should-error (noema-agenda--snapshot-task snapshot '((source . "@@todo [Same]")
                                                         (sourceRef . ((revision . "v0") (index . 14))))) :type 'user-error)))

(ert-deftest noema-agenda-navigation-verifies-utf16-and-rejects-source-edits ()
  (with-temp-buffer
    (insert "😀\n@@todo [Real]")
    (cl-letf (((symbol-function 'recenter) #'ignore))
      (noema-agenda--goto-snapshot-task '((index . 3) (source . "@@todo [Real]")))
      (should (= (point) 3))
      (should-error (noema-agenda--goto-snapshot-task '((index . 1) (source . "@@todo [Real]"))) :type 'user-error))))

(ert-deftest noema-agenda-navigation-discards-delayed-result-after-edit ()
  (let ((buffer (generate-new-buffer " *agenda source*")) callback visited)
    (unwind-protect
        (save-window-excursion
          (with-current-buffer buffer
            (setq buffer-file-name "/tmp/task.md")
            (insert "@@todo [Real]"))
          (cl-letf (((symbol-function 'find-file-noselect) (lambda (&rest _) buffer))
                    ((symbol-function 'noema-agenda--call)
                     (lambda (op body cb)
                       (should (equal op "document"))
                       (should (equal (alist-get 'content body) "@@todo [Real]"))
                       (setq callback cb)))
                    ((symbol-function 'noema-agenda--goto-snapshot-task) (lambda (_) (setq visited t))))
            (noema-agenda-visit-record '((file . "/tmp/task.md") (source . "@@todo [Real]")))
            (with-current-buffer buffer (insert "Changed "))
            (funcall callback '((todos . [])) nil)
            (should-not visited)))
      (kill-buffer buffer))))
