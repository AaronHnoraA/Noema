(ert-deftest noema-agenda-source-label-counts-files-instead-of-tasks ()
  (with-temp-buffer
    (noema-agenda-mode)
    (let* ((snapshot (noema-agenda-test--snapshot))
           (first (aref (alist-get 'todos snapshot) 0))
           (second (copy-tree first)))
      (setf (alist-get 'uid second) "same-file-two"
            (alist-get 'text second) "Second native task"
            (alist-get 'todos snapshot) (vector first second))
      (setq noema-agenda--from "2026-09-15"
            noema-agenda--blocks '((todo)))
      (noema-agenda--render snapshot)
      (should (string-match-p "note:.*Native task" (buffer-string)))
      (should (string-match-p "note:.*Second native task" (buffer-string)))
      (should-not (string-match-p "vault/note" (buffer-string))))))

