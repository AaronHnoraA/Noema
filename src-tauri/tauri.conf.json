{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noema",
  "mainBinaryName": "Noema",
  "version": "0.3.1",
  "identifier": "com.noema.desktop",
  "build": {
    "frontendDist": "../dist/aaronnote"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["desktop"]
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/noema-node"],
    "resources": {
      "../web-host.mjs": "web-host.mjs",
      "../server/": "server/",
      "../shared/": "shared/",
      "../dist/aaronnote/": "dist/aaronnote/",
      "../js/": "js/",
      "../agents/": "agents/",
      "../plugins/": "plugins/",
      "../resources/": "resources/",
      "../src/styles/themes/": "src/styles/themes/",
      "../package.json": "package.json"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "files": {},
      "infoPlist": "Info.plist"
    }
  }
}
