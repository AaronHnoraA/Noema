{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Noema desktop bridge for the loopback web host",
  "windows": ["*"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-open-files",
    "allow-close-window",
    "allow-open-target",
    "allow-update-window-state",
    "allow-show-menu",
    "allow-reveal-path",
    "allow-open-path",
    "allow-open-external",
    "allow-choose-save-path",
    "allow-read-clipboard",
    "allow-choose-directory",
    "allow-list-plugins",
    "allow-set-plugin-enabled",
    "allow-read-dropped-files",
    "allow-broadcast-app-config",
    "allow-desktop-smoke-report"
  ]
}
