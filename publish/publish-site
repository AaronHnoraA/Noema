def should_skip(path: Path) -> bool:
    return any(part in SKIP_DIRS for part in path.parts)


def project_rel_path(path: Path) -> Path:
    try:
        return path.relative_to(ROOT)
    except ValueError:
        pass
    try:
        return Path("roam") / path.resolve().relative_to(ROAM_ROOT.resolve())
    except ValueError as err:
        raise ValueError(f"path is outside publish root: {path}") from err


def iter_project_files() -> Iterator[Path]:
    seen_dirs: set[tuple[int, int]] = set()

    def _walk(walk_root: Path, rel_base: Path | None = None) -> Iterator[Path]:
        for dirpath, dirnames, filenames in os.walk(walk_root, followlinks=True, onerror=lambda _err: None):
            current = Path(dirpath)
            try:
                stat = current.stat()
            except OSError:
                dirnames[:] = []
                continue
            key = (stat.st_dev, stat.st_ino)
            if key in seen_dirs:
                dirnames[:] = []
                continue
            seen_dirs.add(key)
            if rel_base is not None:
                rel_dir = rel_base / current.relative_to(walk_root)
            else:
                try:
                    rel_dir = current.relative_to(ROOT)
                except ValueError:
                    dirnames[:] = []
                    continue
            dirnames[:] = [d for d in dirnames if not should_skip(rel_dir / d)]
            for filename in filenames:
                yield current / filename

    yield from _walk(ROOT)
    # Walk ROAM_ROOT directly when ROOT/roam is not a live symlink to it.
    roam_link = ROOT / "roam"
    if not (roam_link.is_symlink() and roam_link.resolve() == ROAM_ROOT.resolve()):
        if ROAM_ROOT.exists():
            yield from _walk(ROAM_ROOT, rel_base=Path("roam"))


def parse_metadata_block(text: str) -> tuple[dict[str, object], str]:
    match = ORG_META_RE.match(text)
    if match:
        return parse_meta_lines(match.group(1), org_style=True), text[match.end():]
    match = FRONT_MATTER_RE.match(text)
    if not match:
        return {}, text
    return parse_meta_lines(match.group(1), org_style=False), text[match.end():]


def parse_meta_lines(raw: str, org_style: bool) -> dict[str, object]:
    metadata: dict[str, object] = {}
    current_list: str | None = None
    for raw_line in raw.splitlines():
        line = raw_line.rstrip()
        item = re.match(r"^\s*-\s*(.+?)\s*$", line)
        if item and current_list:
            metadata.setdefault(current_list, [])
            assert isinstance(metadata[current_list], list)
            metadata[current_list].append(parse_yaml_scalar(item.group(1)))
            continue
        pair = re.match(r"^([A-Za-z0-9_-]+):(?:\s*(.*))?$", line)
        if not pair:
            continue
        key, value = pair.group(1), (pair.group(2) or "").strip()
        if value == "":
            metadata[key] = []
            current_list = key
        else:
            if org_style and key in {"tags", "aliases", "refs"}:
                metadata[key] = [normalize_meta_string(part) for part in value.split(",") if part.strip()]
            else:
                metadata[key] = parse_yaml_scalar(value)
            current_list = None
    return metadata


def normalize_meta_string(value: object) -> str:
    return str(value).strip().strip('"').replace("\\_", "_")


def normalize_note_kind(value: object) -> str:
    if isinstance(value, list):
        value = value[0] if value else ""
    kind = normalize_meta_string(value).lower()
    if kind in DEFAULT_NOTE_KIND_ALIASES:
        return DEFAULT_NOTE_KIND
    if not KIND_NAME_RE.fullmatch(kind):
        return DEFAULT_NOTE_KIND
    return kind


def note_kind_from_metadata(metadata: dict[str, object]) -> str:
    return normalize_note_kind(metadata.get("kind") or metadata.get("kinds") or DEFAULT_NOTE_KIND)


def active_note_kind(note: Note) -> str:
    return "" if note.kind == DEFAULT_NOTE_KIND else note.kind


def script_json(value: object) -> str:
    return (
        json.dumps(value, ensure_ascii=False)
        .replace("<", "\\u003c")
        .replace(">", "\\u003e")
        .replace("&", "\\u0026")
    )


def parse_yaml_scalar(value: str) -> object:
    value = value.strip()
    if value in {"true", "false"}:
        return value == "true"
    if value.startswith('"') and value.endswith('"'):
        return value[1:-1].replace('\\"', '"').replace("\\\\", "\\").replace("\\_", "_")
    return value.replace("\\_", "_")


def truthy(value: object) -> bool:
    if isinstance(value, bool):
        return value
    return str(value or "").strip().lower() in {"true", "yes", "private", "hidden", "sealed", "no-export"}


def private_metadata_p(metadata: dict[str, object], tags: list[str]) -> bool:
    normalized_tags = {tag.lower() for tag in tags}
    visibility = str(metadata.get("visibility") or metadata.get("access") or "").strip().lower()
    return (
        truthy(metadata.get("private"))
        or truthy(metadata.get("hidden"))
        or truthy(metadata.get("sealed"))
        or metadata.get("publish") is False
        or visibility in {"private", "hidden", "sealed"}
        or bool(normalized_tags & {"private", "hidden", "sealed", "no-export", "noexport"})
    )


def private_path_p(rel_path: Path) -> bool:
    return any(rel_path == prefix or prefix in rel_path.parents for prefix in PRIVATE_PATH_PREFIXES)


def _load_sensitive_tags() -> frozenset[str]:
    if not SENSITIVE_TAGS_FILE.exists():
        return frozenset()
    try:
        data = json.loads(SENSITIVE_TAGS_FILE.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return frozenset()
    items = data if isinstance(data, list) else data.get("tags", []) if isinstance(data, dict) else []
    return frozenset(str(t).strip().lower() for t in items if t)


SENSITIVE_TAGS: frozenset[str] = _load_sensitive_tags()


def filter_sensitive_tags(tags: list[str]) -> list[str]:
    """Mask tags that match sensitive-tags.json while preserving tag graph edges."""
    if not SENSITIVE_TAGS:
        return tags
    return [
        sealed_tag_mask(t.strip().lower()) if t.strip().lower() in SENSITIVE_TAGS else t
        for t in tags
    ]


def sanitize_published_metadata_tags(text: str) -> str:
    if not SENSITIVE_TAGS:
        return text

    def mask_csv(value: str) -> str:
        return ", ".join(filter_sensitive_tags([part.strip() for part in value.split(",") if part.strip()]))

    org_match = ORG_META_RE.match(text)
    if org_match:
        body = org_match.group(1)

        def replace_org_tags(match: re.Match[str]) -> str:
            return f"{match.group(1)}{mask_csv(match.group(2))}"

        masked = re.sub(r"(?im)^([ \t]*tags:[ \t]*)(.*?)$", replace_org_tags, body)
        return text[:org_match.start(1)] + masked + text[org_match.end(1):]

    yaml_match = FRONT_MATTER_RE.match(text)
    if yaml_match:
        body = yaml_match.group(1)
        lines = body.splitlines()
        out: list[str] = []
        in_tags_list = False
        tag_indent = ""
        for line in lines:
            tag_line = re.match(r"^([ \t]*tags:[ \t]*)(.*?)$", line, flags=re.I)
            if tag_line:
                value = tag_line.group(2)
                if value:
                    out.append(f"{tag_line.group(1)}{mask_csv(value)}")
                    in_tags_list = False
                else:
                    out.append(line)
                    in_tags_list = True
                    tag_indent = tag_line.group(1).split("tags:", 1)[0]
                continue
            item = re.match(r"^([ \t]*)-[ \t]*(.*?)[ \t]*$", line)
            if in_tags_list and item and item.group(1).startswith(tag_indent):
                tag = item.group(2)
                out.append(f"{item.group(1)}- {filter_sensitive_tags([tag])[0] if tag else tag}")
                continue
            if in_tags_list and line.strip() and not line.startswith((" ", "\t")):
                in_tags_list = False
            out.append(line)
        masked = "\n".join(out)
        return text[:yaml_match.start(1)] + masked + text[yaml_match.end(1):]

    return text


def clean_markdown_text(text: str) -> str:
    _metadata, body = parse_metadata_block(text)
    body = re.sub(r"```.*?```", " ", body, flags=re.S)
    body = re.sub(r"<!--.*?-->", " ", body, flags=re.S)
    previous = None
    while previous != body:
        previous = body
        body = ORG_ENV_RE.sub(lambda match: match.group(3), body)
    body = re.sub(r"(?m)^#\+(?:begin|end)(?:_|\s+)[^\n]*", " ", body)
    body = re.sub(r"!\[[^\]]*\]\([^)]+\)", " ", body)
    body = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", body)
    body = re.sub(r"#+|[*_`$>|-]", " ", body)
    return " ".join(body.split())


def private_asset_paths(note: Note) -> set[Path]:
    if not note.private:
        return set()
    try:
        text = note.path.read_text(encoding="utf-8")
    except OSError:
        return set()
    paths: set[Path] = set()
    for raw_path in MD_IMAGE_RE.findall(text):
        asset_path = Path(raw_path.split("#", 1)[0])
        if asset_path.is_absolute():
            paths.add(asset_path.resolve())
        else:
            paths.add((note.path.parent / asset_path).resolve())
    for rel_dir in (
        Path("img") / note.path.stem,
        Path("assets") / "img" / note.path.stem,
    ):
        directory = note.path.parent / rel_dir
        if directory.exists():
            paths.update(path.resolve() for path in directory.rglob("*") if path.is_file())
    return paths


def private_static_asset_paths(notes: list[Note]) -> set[Path]:
    paths: set[Path] = set()
    for note in notes:
        paths.update(private_asset_paths(note))
    for prefix in PRIVATE_PATH_PREFIXES:
        parts = Path(prefix).parts
        if parts and parts[0] == "roam":
            directory = ROAM_ROOT / Path(*parts[1:]) if len(parts) > 1 else ROAM_ROOT
        else:
            directory = ROOT / prefix
        if directory.exists():
            paths.update(
                path.resolve()
                for path in directory.rglob("*")
                if path.is_file() and path.suffix.lower() in NOTE_STATIC_EXTENSIONS
            )
    return paths


def parse_note(path: Path) -> Note | None:
    text = path.read_text(encoding="utf-8")
    metadata, _body = parse_metadata_block(text)
    note_id = metadata.get("id") or ""
    if not note_id:
        return None
    rel = project_rel_path(path)
    rel_path = rel.as_posix()
    tags = [str(tag) for tag in metadata.get("tags", [])] if isinstance(metadata.get("tags"), list) else []
    aliases = [str(alias) for alias in metadata.get("aliases", [])] if isinstance(metadata.get("aliases"), list) else []
    private = private_path_p(rel) or private_metadata_p(metadata, tags)
    refs = sorted(set(MD_LINK_RE.findall(text)))
    search_text = "This note has been sealed by the administrator." if private else clean_markdown_text(text)
    return Note(
        path=path,
        rel_path=rel_path,
        id=str(note_id),
        title=str(metadata.get("title") or path.stem),
        date=str(metadata.get("date") or "Undated"),
        tags=tags,
        aliases=aliases,
        kind=note_kind_from_metadata(metadata),
        summary=search_text[:180],
        search_text=search_text,
        refs=refs,
        private=private,
    )


def first_markdown_heading(text: str) -> str | None:
    for line in text.splitlines():
        match = re.match(r"^\s*#\s+(.+?)\s*$", line)
        if match:
            return match.group(1).strip()
    return None


def parse_note_for_export(path: Path) -> Note:
    note = parse_note(path)
    if note:
        return note

    text = path.read_text(encoding="utf-8")
    metadata, body = parse_metadata_block(text)
    rel = project_rel_path(path)
    rel_path = rel.as_posix()
    tags = [str(tag) for tag in metadata.get("tags", [])] if isinstance(metadata.get("tags"), list) else []
    aliases = [str(alias) for alias in metadata.get("aliases", [])] if isinstance(metadata.get("aliases"), list) else []
    private = private_path_p(rel) or private_metadata_p(metadata, tags)
    note_id = str(metadata.get("id") or path.stem)
    return Note(
        path=path,
        rel_path=rel_path,
        id=note_id,
        title=str(metadata.get("title") or first_markdown_heading(body) or path.stem),
        date=str(metadata.get("date") or "Undated"),
        tags=tags,
        aliases=aliases,
        kind=note_kind_from_metadata(metadata),
        summary=clean_markdown_text(text)[:180],
        search_text=clean_markdown_text(text),
        refs=sorted(set(MD_LINK_RE.findall(text))),
        private=private,
    )


def find_notes() -> list[Note]:
    notes: list[Note] = []
    for path in iter_project_files():
        if path.suffix != ".md":
            continue
        try:
            rel = project_rel_path(path)
        except ValueError:
            continue
        if should_skip(rel) or path.name.endswith("~"):
            continue
        if not rel.parts or rel.parts[0] != "roam":
            continue
        note = parse_note(path)
        if note:
            notes.append(note)
    return sorted(notes, key=lambda note: (note.date, note.title), reverse=True)


def deps_file_for(output_file: Path, output_root: Path = PUBLIC) -> Path:
    rel = output_file.relative_to(output_root)
    return STATE_DIR / "deps" / rel.with_suffix(".json")


def publish_forced() -> bool:
    return os.environ.get("PUBLISH_FORCE") == "1"


def git_head(cwd: Path = ROOT) -> str | None:
    try:
        return subprocess.check_output(
            ["git", "rev-parse", "HEAD"],
            cwd=cwd,
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None


def roam_git_head() -> str | None:
    """HEAD of the Noema roam repo (separate git repo, symlinked at ROOT/roam)."""
    return git_head(ROAM_ROOT)


def roam_inputs_dirty() -> bool:
    try:
        output = subprocess.check_output(
            ["git", "status", "--porcelain", "--untracked-files=all"],
            cwd=ROAM_ROOT,
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (subprocess.CalledProcessError, FileNotFoundError):
        return True
    return bool(output.strip())


def runtime_git_head() -> str | None:
    """HEAD of the Emacs repository that owns the Noema runtime."""
    return git_head(RUNTIME_ROOT)


def runtime_inputs_dirty() -> bool:
    """Return True when any Noema runtime or publish input is uncommitted."""
    try:
        output = subprocess.check_output(
            ["git", "status", "--porcelain", "--untracked-files=all", "."],
            cwd=RUNTIME_ROOT,
            text=True,
            stderr=subprocess.DEVNULL,
        )
        return bool(output.strip())
    except (subprocess.CalledProcessError, FileNotFoundError):
        return True


def static_publish_pairs() -> list[tuple[Path, Path]]:
    pairs = [*PUBLISHED_ASSET_SOURCES, *REVEAL_ASSET_SOURCES]
    for source in ASSETS_DIR.rglob("*"):
        if not source.is_file():
            continue
        rel = source.relative_to(ASSETS_DIR)
        if source.name.startswith(".") or source.name.endswith("~") or should_skip(rel):
            continue
        if source.suffix.lower() in STATIC_EXTENSIONS:
            pairs.append((source, rel))
    pairs.extend(
        (ASSETS_DIR / template, Path(output))
        for template, output in (("homepage.html", "index.html"), ("notes.html", "notes.html"))
    )
    return pairs


def publish_outputs_exist(notes: list[Note]) -> bool:
    required = [PUBLIC / "js" / "data.js", PUBLIC / "index.html", PUBLIC / "notes.html"]
    required.extend(PUBLIC / note.link for note in notes)
    required.extend(PUBLIC / target for _source, target in static_publish_pairs())
    return all(path.exists() for path in required) and not missing_site_shell_assets()


def missing_site_shell_assets() -> list[str]:
    missing: list[str] = []
    for page in (PUBLIC / "index.html", PUBLIC / "notes.html"):
        if not page.exists():
            missing.append(page.relative_to(PUBLIC).as_posix())
            continue
        try:
            html = page.read_text(encoding="utf-8")
        except OSError:
            missing.append(page.relative_to(PUBLIC).as_posix())
            continue
        for raw_url in HTML_SHELL_ASSET_RE.findall(html):
            url = unquote(raw_url.split("#", 1)[0].split("?", 1)[0]).strip()
            if not url or url.startswith("//") or re.match(r"^[a-z][a-z0-9+.-]*:", url, flags=re.I):
                continue
            target = PUBLIC / url.lstrip("/") if url.startswith("/") else page.parent / url
            if not target.exists():
                missing.append(f"{page.name}: {raw_url}")
    return sorted(set(missing))


def validate_site_shell_assets() -> None:
    missing = missing_site_shell_assets()
    if missing:
        raise RuntimeError("Published site references missing assets:\n  " + "\n  ".join(missing))


def published_assets_current() -> bool:
    for source, target in static_publish_pairs():
        output = PUBLIC / target
        if not source.exists() or not output.exists():
            return False
        try:
            if not filecmp.cmp(source, output, shallow=False):
                return False
        except OSError:
            return False
    return True


def publish_state_current(
    notes: list[Note],
    head: str | None,
    roam_head: str | None,
    runtime_head: str | None,
) -> bool:
    if (
        publish_forced()
        or not head
        or not runtime_head
        or roam_inputs_dirty()
        or runtime_inputs_dirty()
        or not PUBLISH_STATE.exists()
    ):
        return False
    try:
        state = json.loads(PUBLISH_STATE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return False
    return (
        state.get("gitHead") == head
        and state.get("roamGitHead") == roam_head
        and state.get("runtimeGitHead") == runtime_head
        and state.get("dirty") is False
        and state.get("noteCount") == len(notes)
        and publish_outputs_exist(notes)
        and published_assets_current()
    )


def write_publish_state(
    notes: list[Note],
    rendered: int,
    skipped: int,
    head: str | None,
    roam_head: str | None,
    runtime_head: str | None,
) -> None:
    state = {
        "gitHead": head,
        "roamGitHead": roam_head,
        "runtimeGitHead": runtime_head,
        "dirty": runtime_inputs_dirty() or roam_inputs_dirty(),
        "noteCount": len(notes),
        "rendered": rendered,
        "skipped": skipped,
    }
    PUBLISH_STATE.write_text(json.dumps(state, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def path_from_dep(dep: str) -> Path:
    path = Path(dep)
    return path if path.is_absolute() else ROOT / path


def output_is_current(output_file: Path, deps_file: Path) -> bool:
    if publish_forced():
        return False
    if not output_file.exists() or not deps_file.exists():
        return False
    try:
        deps = json.loads(deps_file.read_text(encoding="utf-8")).get("inputs", [])
    except (OSError, json.JSONDecodeError):
        return False
    output_mtime = output_file.stat().st_mtime
    for dep in deps:
        dep_path = path_from_dep(str(dep))
        if not dep_path.exists() or dep_path.stat().st_mtime > output_mtime:
            return False
    return True


def deps_for_note(note: Note, notes_by_rel: dict[str, Note] | None = None) -> set[str]:
    deps = {
        note.public_path if note.private else project_rel_path(note.path).as_posix(),
        str(RUNTIME_ROOT / "scripts" / "render-html.mjs"),
        str(RUNTIME_ROOT / "aaronnote" / "style.css"),
        str(RUNTIME_ROOT / "aaronnote" / "published-toc.js"),
        str(RUNTIME_ROOT / "aaronnote" / "published-local-graph.js"),
        str(RUNTIME_ROOT / "js" / "note-page.js"),
        str(RUNTIME_ROOT / "src" / "styles" / "widgets.css"),
        str(RUNTIME_ROOT / "src" / "styles" / "theme-typora.css"),
        str(RUNTIME_ROOT / "src" / "styles" / "typography.css"),
        str(ASSETS_DIR / "css" / "aaronnote-published.css"),
    }
    fonts_dir = RUNTIME_ROOT / "src" / "styles" / "fonts"
    if fonts_dir.exists():
        deps.update(str(path) for path in fonts_dir.iterdir() if path.is_file())
    src_dir = RUNTIME_ROOT / "src"
    if src_dir.exists():
        deps.update(str(path) for path in src_dir.glob("**/*.ts"))
    lean_path = lean_mirror_path(note.path)
    try:
        note_has_lean_regions = bool(MARKDOWN_LEAN_TAG_RE.search(note.path.read_text(encoding="utf-8")))
    except OSError:
        note_has_lean_regions = False
    if lean_path.exists() or note_has_lean_regions:
        deps.add(project_rel_path(lean_path).as_posix())
    deps.update(str(path) for path in note_kind_asset_paths(note))
    return deps


def executable_from_path(value: str) -> str | None:
    value = value.strip()
    if not value:
        return None
    if os.sep in value:
        return value if Path(value).exists() else None
    return shutil.which(value)


def node_executable() -> str:
    for value in (
        os.environ.get("AARONNOTE_NODE", ""),
        os.environ.get("NODE_BINARY", ""),
        "node",
        "/opt/homebrew/bin/node",
        "/usr/local/bin/node",
        str(Path.home() / ".nix-profile" / "bin" / "node"),
        "/run/current-system/sw/bin/node",
    ):
        resolved = executable_from_path(value)
        if resolved:
            return resolved

    try:
        resolved = subprocess.check_output(
            ["/bin/zsh", "-lc", "command -v node"],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except (OSError, subprocess.CalledProcessError):
        resolved = ""
    if resolved:
        return resolved
    raise RuntimeError("Noema renderer failed: node executable not found")


def render_aaronnote_payload(payload: dict[str, object]) -> str:
    try:
        result = subprocess.run(
            [node_executable(), str(RUNTIME_ROOT / "scripts" / "render-html.mjs")],
            cwd=str(RUNTIME_ROOT),
            input=json.dumps(payload, ensure_ascii=False),
            text=True,
            check=True,
            capture_output=True,
        )
    except (OSError, subprocess.CalledProcessError) as err:
        stderr = err.stderr if isinstance(err, subprocess.CalledProcessError) else str(err)
        raise RuntimeError(f"Noema renderer failed: {stderr}") from err
    try:
        return str(json.loads(result.stdout)["html"])
    except (json.JSONDecodeError, KeyError) as err:
        raise RuntimeError(f"Noema renderer returned invalid JSON: {result.stdout[:500]}") from err


def render_aaronnote_payloads(payloads: list[dict[str, object]]) -> list[str]:
    if not payloads:
        return []
    try:
        result = subprocess.run(
            [node_executable(), str(RUNTIME_ROOT / "scripts" / "render-html.mjs")],
            cwd=str(RUNTIME_ROOT),
            input=json.dumps({"batch": payloads}, ensure_ascii=False),
            text=True,
            check=True,
            capture_output=True,
        )
    except (OSError, subprocess.CalledProcessError) as err:
        stderr = err.stderr if isinstance(err, subprocess.CalledProcessError) else str(err)
        raise RuntimeError(f"Noema renderer failed: {stderr}") from err
    try:
        html = json.loads(result.stdout)["html"]
    except (json.JSONDecodeError, KeyError) as err:
        raise RuntimeError(f"Noema renderer returned invalid JSON: {result.stdout[:500]}") from err
    if not isinstance(html, list) or len(html) != len(payloads):
        raise RuntimeError(f"Noema renderer returned {len(html) if isinstance(html, list) else 'invalid'} batch items for {len(payloads)} inputs")
    return [str(item) for item in html]


def render_aaronnote_markdown(text: str) -> str:
    return render_aaronnote_payload({"markdown": text})


def normalize_lean_tag(value: object) -> str:
    tag = re.sub(r"[^A-Za-z0-9_.:-]+", "-", str(value or "").strip().strip("[]"))
    return tag.strip("-")[:80]


def lean_mirror_path(note_path: Path) -> Path:
    rel = project_rel_path(note_path)
    if rel.parts and rel.parts[0] == "roam":
        rel = Path(*rel.parts[1:])
    if rel.suffix.lower() in {".md", ".markdown"}:
        rel = rel.with_suffix(".lean")
    else:
        rel = Path(f"{rel.as_posix()}.lean")
    return ROAM_ROOT / ".lean" / rel


def scan_lean_regions(text: str) -> dict[str, str]:
    matches = list(LEAN_REGION_MARKER_RE.finditer(text))
    regions: dict[str, str] = {}
    for index, match in enumerate(matches):
        tag = normalize_lean_tag(match.group(1))
        if not tag:
            continue
        body_from = match.end()
        if body_from < len(text) and text[body_from] == "\n":
            body_from += 1
        body_to = matches[index + 1].start() if index + 1 < len(matches) else len(text)
        regions[tag] = text[body_from:body_to].rstrip("\n")
    return regions


def lean_regions_for_note(note: Note, markdown_text: str) -> dict[str, str]:
    tags = [normalize_lean_tag(match.group(1)) for match in MARKDOWN_LEAN_TAG_RE.finditer(markdown_text)]
    tags = [tag for tag in tags if tag]
    if not tags:
        return {}
    path = lean_mirror_path(note.path)
    try:
        regions = scan_lean_regions(path.read_text(encoding="utf-8"))
    except OSError:
        return {}
    wanted = set(tags)
    return {tag: body for tag, body in regions.items() if tag in wanted}


def site_root_for(note_link: str) -> str:
    depth = len(Path(note_link).parent.parts)
    return "../" * depth or "./"


def pdf_export_p() -> bool:
    return os.environ.get("AARONNOTE_EXPORT_FORMAT") == "pdf"


def note_output_link(note: Note) -> str:
    if pdf_export_p():
        return Path(note.rel_path).with_suffix(".html").as_posix()
    return note.link


def note_render_payload(
    note: Note,
    markdown_text: str,
    *,
    include_private_content: bool = False,
    lean_regions: dict[str, str] | None = None,
    notes_by_rel: dict[str, Note] | None = None,
) -> dict[str, object]:
    root = site_root_for(note_output_link(note))
    kind = active_note_kind(note)
    export_format = "pdf" if pdf_export_p() else "html"
    title = note.title if pdf_export_p() else note.public_title
    return {
        "mode": "published-note",
        "markdown": markdown_text,
        "note": {
            "title": title,
            "group": note.group_label,
            "date": note.date,
            "root": root,
            "kind": kind or DEFAULT_NOTE_KIND,
            "format": export_format,
            "noteThemeVersion": NOTE_THEME_VERSION,
            "kindAssetsHtml": note_kind_assets_html(note, root),
            "private": note.private,
            "includePrivateContent": include_private_content,
            "leanRegions": lean_regions or {},
        },
    }


def note_page_html(
    note: Note,
