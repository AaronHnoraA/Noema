def _copy_into_public(source: Path, target: Path) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists() and not target.is_symlink():
        try:
            source_stat = source.stat()
            target_stat = target.stat()
            if (
                source_stat.st_size == target_stat.st_size
                and source_stat.st_mtime_ns == target_stat.st_mtime_ns
            ):
                return
        except OSError:
            pass
    if target.is_symlink() or target.exists():
        target.unlink()
    shutil.copy2(source, target)


def copy_published_assets(output_root: Path) -> None:
    required_sources = [*PUBLISHED_ASSET_SOURCES, *REVEAL_ASSET_SOURCES]
    missing = [str(src_path) for src_path, _dst_rel in required_sources if not src_path.exists()]
    if missing:
        raise RuntimeError("Missing required publish assets:\n  " + "\n  ".join(missing))
    for src_path, dst_rel in required_sources:
        _copy_into_public(src_path, output_root / dst_rel)
    fonts_dir = RUNTIME_ROOT / "src" / "styles" / "fonts"
    if fonts_dir.exists():
        for src_path in fonts_dir.iterdir():
            if src_path.is_file():
                _copy_into_public(src_path, output_root / "Noema" / "src" / "styles" / "fonts" / src_path.name)


def markdown_asset_target(note: Note, raw_path: str) -> Path | None:
    path_text = unquote(raw_path.split("#", 1)[0].split("?", 1)[0]).strip()
    if not path_text or re.match(r"^[a-z][a-z0-9+.-]*:", path_text, flags=re.I):
        return None
    asset_path = Path(path_text)
    return asset_path if asset_path.is_absolute() else note.path.parent / asset_path


def note_static_asset_paths(note: Note) -> set[Path]:
    try:
        text = note.path.read_text(encoding="utf-8")
    except OSError:
        return set()

    paths: set[Path] = set()
    for raw_path in [*MD_IMAGE_RE.findall(text), *MD_LINK_RE.findall(text)]:
        asset_path = markdown_asset_target(note, raw_path)
        if not asset_path:
            continue
        if asset_path.exists() and asset_path.is_file() and asset_path.suffix.lower() in NOTE_STATIC_EXTENSIONS:
            paths.add(asset_path.resolve())

    for rel_dir in (
        Path("img") / note.path.stem,
        Path("images") / note.path.stem,
        Path("assets") / "img" / note.path.stem,
    ):
        directory = note.path.parent / rel_dir
        if directory.exists():
            paths.update(
                path.resolve()
                for path in directory.rglob("*")
                if path.is_file() and path.suffix.lower() in NOTE_STATIC_EXTENSIONS
            )
    return paths


def copy_note_static_assets(
    note: Note,
    output_root: Path,
    notes_by_rel: dict[str, Note] | None = None,
    *,
    include_private_content: bool = False,
) -> None:
    if note.private and not include_private_content:
        return
    sources = set(note_static_asset_paths(note))
    _ = notes_by_rel
    for source in sources:
        try:
            rel = project_rel_path(source)
        except ValueError:
            continue
        _copy_into_public(source, output_root / rel)


def note_kind_asset_paths(note: Note) -> set[Path]:
    kind = active_note_kind(note)
    if not kind:
        return set()
    root = ASSETS_DIR / "kinds" / kind
    return {
        path
        for path in (root / "index.css", root / "index.js")
        if path.exists() and path.is_file()
    }


def copy_note_kind_assets(note: Note, output_root: Path) -> None:
    for source in note_kind_asset_paths(note):
        _copy_into_public(source, output_root / "kinds" / source.relative_to(ASSETS_DIR / "kinds"))


def note_kind_assets_html(note: Note, root: str) -> str:
    kind = active_note_kind(note)
    if not kind:
        return ""
    asset_root = ASSETS_DIR / "kinds" / kind
    css = asset_root / "index.css"
    js = asset_root / "index.js"
    lines: list[str] = []
    if css.exists():
        lines.append(f'  <link rel="stylesheet" href="{root}kinds/{kind}/index.css?v={NOTE_THEME_VERSION}" />')
    if js.exists():
        context = {
            "kind": kind,
            "title": note.public_title,
            "path": note.public_path,
            "articleId": "content",
        }
        lines.append(
            "  <script type=\"module\">\n"
            f"    const context = {{ ...{script_json(context)}, article: document.getElementById('content') }};\n"
            f"    const mod = await import('{root}kinds/{kind}/index.js?v={NOTE_THEME_VERSION}');\n"
            "    const setup = typeof mod.default === 'function' ? mod.default : typeof mod.setup === 'function' ? mod.setup : null;\n"
            "    const cleanup = setup ? setup(context) : null;\n"
            "    window.addEventListener('pagehide', () => {\n"
            "      if (typeof cleanup === 'function') cleanup();\n"
            "      else if (typeof mod.teardown === 'function') mod.teardown(context);\n"
            "    }, { once: true });\n"
            "    window.dispatchEvent(new CustomEvent('aaronnote:kind-ready', { detail: context }));\n"
            "  </script>"
        )
    return "\n".join(lines)


def copy_static(notes: list[Note]) -> None:
    private_assets = private_static_asset_paths(notes)

    # Copy roam static assets (images, visual attachments) from project files walk.
    for path in iter_project_files():
        if not path.is_file() or path.resolve() in private_assets:
            continue
        try:
            rel = project_rel_path(path)
        except ValueError:
            continue
        if should_skip(rel) or path.name.startswith(".") or path.name.endswith("~"):
            continue
        suffix = path.suffix.lower()
        # Only copy roam files (images + visual attachments).
        if not (rel.parts and rel.parts[0] == "roam"):
            continue
        if suffix not in (IMAGE_EXTENSIONS | VISUAL_ATTACHMENT_EXTENSIONS):
            continue
        _copy_into_public(path, PUBLIC / rel)

    # Copy site static assets (css/, js/, kinds/, etc.) from ASSETS_DIR.
    for path in ASSETS_DIR.rglob("*"):
        if not path.is_file():
            continue
        rel = path.relative_to(ASSETS_DIR)
        if path.name.startswith(".") or path.name.endswith("~") or should_skip(rel):
            continue
        if path.suffix.lower() not in STATIC_EXTENSIONS:
            continue
        _copy_into_public(path, PUBLIC / rel)

    for template, output in (("homepage.html", "index.html"), ("notes.html", "notes.html")):
        source = ASSETS_DIR / template
        if source.exists():
            _copy_into_public(source, PUBLIC / output)


def clean_stale_outputs(notes: list[Note]) -> None:
    expected_html = {note.link for note in notes}
    private_assets = private_static_asset_paths(notes)
    roam_public = PUBLIC / "roam"
    if roam_public.exists():
        for dirpath, dirnames, _filenames in os.walk(roam_public, topdown=True, followlinks=False):
            current = Path(dirpath)
            for dirname in list(dirnames):
                if dirname not in SKIP_DIRS:
                    continue
                stale_dir = current / dirname
                if stale_dir.is_symlink():
                    stale_dir.unlink()
                else:
                    shutil.rmtree(stale_dir)
                dirnames.remove(dirname)
        for prefix in PRIVATE_PATH_PREFIXES:
            public_prefix = PUBLIC / prefix
            if public_prefix.exists():
                for public_file in public_prefix.rglob("*"):
                    if public_file.is_file() or public_file.is_symlink():
                        public_file.unlink()
        for source_asset in private_assets:
            try:
                rel = project_rel_path(source_asset)
            except ValueError:
                continue
            public_asset = PUBLIC / rel
            if public_asset.exists() or public_asset.is_symlink():
                public_asset.unlink()
        for html_file in roam_public.glob("**/*.html"):
            rel = html_file.relative_to(PUBLIC).as_posix()
            if rel not in expected_html:
                html_file.unlink()
                deps_file_for(html_file).unlink(missing_ok=True)
        for pdf_file in roam_public.glob("**/*.pdf"):
            pdf_file.unlink()
            deps_file_for(pdf_file).unlink(missing_ok=True)
    for rel in ("diary.html", "sitemap-log.html", "CV/main.pdf"):
        (PUBLIC / rel).unlink(missing_ok=True)


def collect_notes() -> tuple[list[Note], dict[str, Note]]:
    PUBLIC.mkdir(parents=True, exist_ok=True)
    notes = find_notes()
    notes_by_id = {note.id: note for note in notes}
    notes_by_rel = {note.rel_path: note for note in notes}
    backlinks: dict[str, list[str]] = {note.id: [] for note in notes}

    for note in notes:
        resolved_refs: set[str] = set()
        for ref in note.refs:
            if re.match(r"^[a-z][a-z0-9+.-]*:", ref, flags=re.I):
                continue
            ref_path_text = unquote(ref.split("#", 1)[0].split("?", 1)[0]).strip()
            if not ref_path_text:
                continue
            ref_path = (note.path.parent / ref_path_text).resolve()
            try:
                rel = project_rel_path(ref_path).as_posix()
            except ValueError:
                continue
            target = notes_by_rel.get(rel)
            if target and target.id != note.id:
                resolved_refs.add(target.id)
        note.refs = sorted(resolved_refs)
        for ref in note.refs:
            backlinks.setdefault(ref, []).append(note.id)

    for note in notes:
        note.backlinks = sorted(set(backlinks.get(note.id, [])))
    return notes, notes_by_id


def publish_mask_stats(notes: list[Note]) -> tuple[int, int]:
    masks: list[str] = []
    for note in notes:
        for tag in note.tags:
            normalized = tag.strip().lower()
            if normalized in SENSITIVE_TAGS:
                masks.append(sealed_tag_mask(normalized))
    return len(masks), len(set(masks))


def publish_summary(
    notes: list[Note],
    *,
    rendered: int,
    skipped: int,
    head: str | None,
    roam_head: str | None,
    runtime_head: str | None,
    unchanged: bool = False,
) -> None:
    public_count = sum(not note.private for note in notes)
    sealed_count = len(notes) - public_count
    reference_edges = sum(len(note.refs) for note in notes)
    connected_notes = sum(1 for note in notes if note.refs or note.backlinks)
    masked_tags, distinct_masked_tags = publish_mask_stats(notes)
    sealed_groups = len({note.group_key for note in notes if note.private})
    private_assets = len(private_static_asset_paths(notes))
    public_tags = {
        tag
        for note in notes
        if not note.private
        for tag in filter_sensitive_tags(note.tags)
    }
    state = "unchanged" if unchanged else "updated"

    print(f"Publish summary: {state}")
    print(f"  Output: {PUBLIC}")
    print(f"  Notes: {len(notes)} total, {public_count} public, {sealed_count} sealed")
    print(f"  Pages: {rendered} rendered, {skipped} skipped")
    print(f"  Graph: {reference_edges} reference edges, {connected_notes} connected notes")
    print(f"  Tags: {len(public_tags)} public tags, {masked_tags} masked occurrences, {distinct_masked_tags} masked tags")
    print(f"  Privacy: {sealed_groups} sealed groups, {private_assets} private static assets excluded")
    print(
        "  Git: "
        f"publish {head[:12] if head else 'unknown'}, "
        f"roam {roam_head[:12] if roam_head else 'unknown'}, "
        f"runtime {runtime_head[:12] if runtime_head else 'unknown'}"
    )


def arg_value(args: list[str], name: str) -> str | None:
    if name not in args:
        return None
    index = args.index(name)
    if index + 1 >= len(args):
        raise SystemExit(f"{name} requires a value")
    return args[index + 1]


def resolve_root_path(raw_path: str) -> Path:
    path = Path(raw_path).expanduser()
    if not path.is_absolute():
        path = ROOT / path
    return path.resolve()


def publish_single_note(args: list[str]) -> bool:
    raw_note = arg_value(args, "--note")
    if not raw_note:
        return False

    note_path = resolve_root_path(raw_note)
    try:
        rel = project_rel_path(note_path)
    except ValueError as err:
        raise SystemExit(f"Note is outside publish root: {note_path}") from err
    if not note_path.exists() or note_path.suffix.lower() not in {".md", ".markdown"}:
        raise SystemExit(f"Not a Markdown note: {note_path}")
    if should_skip(rel):
        raise SystemExit(f"Skipped path cannot be published: {note_path}")

    output_root = PUBLIC
    raw_output_root = arg_value(args, "--output-root")
    if raw_output_root:
        output_root = resolve_root_path(raw_output_root)

    include_private = "--include-private" in args
    export_format = arg_value(args, "--format")
    previous_export_format = os.environ.get("AARONNOTE_EXPORT_FORMAT")
    if export_format:
        if export_format not in {"html", "pdf"}:
            raise SystemExit(f"Unsupported export format: {export_format}")
        os.environ["AARONNOTE_EXPORT_FORMAT"] = export_format
    note = parse_note_for_export(note_path)
    all_notes = find_notes()
    notes_by_rel = {item.rel_path: item for item in all_notes}
    note = notes_by_rel.get(note.rel_path, note)
    output_root.mkdir(parents=True, exist_ok=True)
    copy_published_assets(output_root)
    copy_note_static_assets(
        note,
        output_root,
        notes_by_rel,
        include_private_content=include_private,
    )
    copy_note_kind_assets(note, output_root)
    output_file = output_root / note_output_link(note)
    try:
        status = render_note_html(
            note,
            output_root=output_root,
            include_private_content=include_private,
            force=True,
            notes_by_rel=notes_by_rel,
        )
    finally:
        if export_format:
            if previous_export_format is None:
                os.environ.pop("AARONNOTE_EXPORT_FORMAT", None)
            else:
                os.environ["AARONNOTE_EXPORT_FORMAT"] = previous_export_format
    print(f"Published {note.rel_path} to {output_file} ({status})")
    return True


def _migrate_roam_symlink() -> None:
    """Detach a legacy ROOT/roam source symlink before creating output there.

    HTML is a supported note attachment, so migration must never delete HTML
    files from the source vault.
    """
    global ROAM_ROOT
    roam_link = ROOT / "roam"
    if roam_link.is_symlink():
        try:
            source_root = roam_link.resolve()
            if source_root == ROAM_ROOT.resolve():
                if ROAM_ROOT.absolute() == roam_link.absolute():
                    ROAM_ROOT = source_root
                roam_link.unlink()
        except OSError:
            pass


def main() -> None:
    args = sys.argv[1:]
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    _migrate_roam_symlink()
    if publish_single_note(args):
        return

    notes, _notes_by_id = collect_notes()
    notes_by_rel = {note.rel_path: note for note in notes}

    head = git_head()
    roam_head = roam_git_head()
    runtime_head = runtime_git_head()

    if "--record-state" in args:
        write_publish_state(notes, 0, len(notes), head, roam_head, runtime_head)
        print(
            "Recorded publish state for "
            f"publish {head[:12] if head else 'unknown'} / "
            f"roam {roam_head[:12] if roam_head else 'unknown'} / "
            f"runtime {runtime_head[:12] if runtime_head else 'unknown'}"
        )
        return

    if publish_state_current(notes, head, roam_head, runtime_head):
        print(f"Published {len(notes)} Markdown notes to {PUBLIC} (unchanged, skipped)")
        publish_summary(
            notes,
            rendered=0,
            skipped=len(notes),
            head=head,
            roam_head=roam_head,
            runtime_head=runtime_head,
            unchanged=True,
        )
        return

    clean_stale_outputs(notes)
    copy_published_assets(PUBLIC)
    copy_static(notes)
    skipped = 0
    pending_renders: list[PendingNoteRender] = []
    for note in notes:
        copy_note_static_assets(note, PUBLIC, notes_by_rel)
        pending = prepare_note_render(note, notes_by_rel=notes_by_rel)
        if pending is None:
            skipped += 1
        else:
            pending_renders.append(pending)
    rendered_html = render_aaronnote_payloads([item.payload for item in pending_renders])
    for pending, html in zip(pending_renders, rendered_html, strict=True):
        write_rendered_note_html(pending, html, notes_by_rel)
    rendered = len(pending_renders)
    write_data(notes)
    validate_site_shell_assets()
    write_publish_state(notes, rendered, skipped, head, roam_head, runtime_head)
    print(f"Published {len(notes)} Markdown notes to {PUBLIC} ({rendered} rendered, {skipped} skipped)")
    publish_summary(
        notes,
        rendered=rendered,
        skipped=skipped,
        head=head,
        roam_head=roam_head,
        runtime_head=runtime_head,
    )


if __name__ == "__main__":
    main()
